# Initial administrator. ADMIN_PASSWORD is only used when the first account is created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Same-origin FastAPI service.
PORT=8080

# Add deployed browser origins as a comma-separated list when the frontend is hosted separately.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(?::\d+)?$

# Optional comma-separated trusted HTTPS hosts for caching covers from custom sources.
COVER_EXTRA_HOSTS=
